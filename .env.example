# Base de datos
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DB=ACUEDUCTO

# Railway tambien puede entregar estas variables automaticamente:
# MYSQLHOST=your-mysql-host
# MYSQLPORT=3306
# MYSQLUSER=your-mysql-user
# MYSQLPASSWORD=your-mysql-password
# MYSQLDATABASE=railway

# Flask
FLASK_SECRET_KEY=replace-with-a-long-random-secret
SESSION_MINUTES=30
SESSION_COOKIE_SECURE=1
LOG_LEVEL=INFO

# Correo SMTP
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@example.com

# OTP
EMAIL_OTP_GRACE_SECONDS=300
EMAIL_OTP_EXPIRES_MINUTES=5
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_LOCK_MINUTES=15

# Seguridad
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
DATA_ENCRYPTION_KEY=replace-with-a-32-byte-hex-key-or-long-secret

# Chat
CHAT_MAX_TOKENS=180
CHAT_CACHE_TTL=3600

# Facturacion
AUTO_FACTURACION_MENSUAL=1
AUTO_FACTURACION_ENVIAR_CORREOS=0

# Google Maps
GOOGLE_MAPS_API_KEY=
